# Backend Dockerfile  
FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev pixman-dev

# Create app directory and user in one step
RUN addgroup -g 1001 -S nodejs && \
    adduser -S strapi -u 1001 && \
    mkdir -p /app && \
    chown strapi:nodejs /app

WORKDIR /app

# Copy package files with correct ownership
COPY --chown=strapi:nodejs backend/package.json backend/package-lock.json ./

# Install dependencies as strapi user
USER strapi
RUN npm ci && npm cache clean --force

# Copy application files with correct ownership
COPY --chown=strapi:nodejs backend/ ./

# Create necessary directories
RUN mkdir -p public/uploads

# Accept build arguments to bake in the correct URLs (Needed for Strapi Admin)
ARG PUBLIC_URL
ARG ADMIN_URL
ARG NODE_ENV=production

# Set them as ENV vars so 'npm run build' can see them
ENV PUBLIC_URL=$PUBLIC_URL
ENV ADMIN_URL=$ADMIN_URL
ENV NODE_ENV=$NODE_ENV

# Force Admin to use relative paths for API calls if possible, or same host
ENV STRAPI_ADMIN_BACKEND_URL=/
ENV STRAPI_ADMIN_zm_BACKEND_URL=/

# Build the admin panel
RUN npm run build

EXPOSE 1337

# Start the Strapi server
CMD ["npm", "start"]
