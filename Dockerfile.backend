# Backend Dockerfile  
FROM node:20-slim

# Install build dependencies and utilities
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    libcairo2-dev \
    libjpeg62-turbo-dev \
    libpango1.0-dev \
    libgif-dev \
    libpixman-1-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory and user
WORKDIR /srv/app
RUN useradd -ms /bin/bash strapi && \
    chown -R strapi:strapi /srv/app

USER strapi

# Copy only package files first (best practice)
COPY --chown=strapi:strapi backend/package.json backend/package-lock.json ./

# Install dependencies safely (REPLACE npm ci)
RUN npm cache clean --force && \
    npm install --legacy-peer-deps && \
    npm install esbuild --legacy-peer-deps && \
    npm cache clean --force

# Copy the full backend source
COPY --chown=strapi:strapi backend/ ./

# Create necessary directories
RUN mkdir -p public/uploads

# Set production environment
ENV NODE_ENV=production

# Expose the Strapi port
EXPOSE 1337

# Start the Strapi server (will auto-build admin panel on first run)
CMD ["npm", "start"]
