{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2021",
    "jsx": "react",
    "checkJs": true,
    "allowJs": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.example.js",
    "src/**/*.example.ts"
  ],
  "typeAcquisition": {
    "enable": false
  }
}