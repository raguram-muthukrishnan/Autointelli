# Environment Variables for Docker Compose
# Copy this file to .env and modify the values as needed

# Frontend Configuration
VITE_STRAPI_URL=http://localhost:1337

# ChatBot WebSocket Configuration
# IMPORTANT: Do not commit actual values to Git - keep these in .env only
VITE_WEBSOCKET_URL=ws://your-websocket-server:8765/
VITE_WEBSOCKET_USER_ID=your_authorized_user_id

# Turnstile (Cloudflare Captcha)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# OpenRouter API Key for ChatBot (DEPRECATED - now using WebSocket)
# Get your API key from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cloudflare Turnstile Site Key
# Get your API key from https://www.cloudflare.com/products/turnstile/
# Default is Cloudflare's test key (Always Pass): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACNa3gqWH2EOSgDO

# Database Configuration (for production with PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=your_secure_password_here

# Strapi Configuration
APP_KEYS=generate_secure_key_1,generate_secure_key_2,generate_secure_key_3,generate_secure_key_4
API_TOKEN_SALT=generate_secure_salt_here
ADMIN_JWT_SECRET=generate_secure_jwt_secret_here
TRANSFER_TOKEN_SALT=generate_secure_transfer_salt_here
JWT_SECRET=generate_secure_jwt_secret_here
ENCRYPTION_KEY=generate_secure_encryption_key_here

# Server Configuration
HOST=0.0.0.0
PORT=1337
NODE_ENV=production